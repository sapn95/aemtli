{
  "name": "aemtli",
  "version": "0.22.0",
  "private": true,
  "description": "Chores for goose: recipes on a Kubernetes schedule, a dashboard of their runs, and a chat, behind Cloudflare Access.",
  "type": "module",
  "bin": {
    "aemtli": "bin/aemtli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "web": "AUTH_MODE=none node bin/aemtli.mjs web",
    "lint": "eslint .",
    "test": "node --test --test-concurrency=1 'test/*.test.mjs'",
    "coverage": "c8 --reporter=text --reporter=text-summary --include='src/**' --check-coverage --lines 90 --functions 90 --branches 80 node --test --test-concurrency=1 'test/*.test.mjs'",
    "hygiene": "node scripts/hygiene.mjs",
    "gate": "npm run lint && npm run hygiene && npm run coverage"
  },
  "license": "MIT",
  "author": "sapn95",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sapn95/aemtli.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "markdown-it": "^15.0.2",
    "yaml": "^2.9.1",
    "zxing-wasm": "3.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.12.0"
  }
}
